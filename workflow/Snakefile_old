        os.path.join(outdir, "derivatives", "dynamic", "task-rest_space-fsLR_seg-DesikanKilliany_den-91k_desc-FCDhistograms_histogram.pkl"),
        os.path.join(outdir, "derivatives", "dynamic", "task-rest_space-fsLR_seg-DesikanKilliany_den-91k_desc-FCDhistogramsRegressed_histogram.pkl")
    params:
