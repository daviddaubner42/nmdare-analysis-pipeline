        exc=os.path.join(outdir, "intermediaries", "networks", "to_delete_network.pkl"),
        ts=os.path.join(rawdir, "xcp_d", "sub-{subid}", "func", "sub-{subid}_task-rest_space-fsLR_seg-DesikanKilliany_den-91k_stat-mean_timeseries.ptseries.nii")
