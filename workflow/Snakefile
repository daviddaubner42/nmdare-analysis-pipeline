rule create_FCDs:
    input:
        os.path.join(outdir, "results", "dynamic", "sub-{subid}", "sub-{subid}_windowed_FCs.pkl")
    params:
        workflowdir = workflowdir,
        outdir = outdir,
        fcdir = os.path.join(outdir, "results", "dynamic"),
        subids=subids
    output:
        os.path.join(outdir, "results", "dynamic", "sub-{subid}", "sub-{subid}_FCD.csv"),
        os.path.join(outdir, "results", "dynamic", "sub-{subid}", "sub-{subid}_FCD_hist.csv")
    conda:
        os.path.join(environmentdir, "environment.yaml")
    shell:
        "python {params.workflowdir}/scripts/create_FCDs.py --windowed_fc_path {input} --out_dir {params.outdir}/results/dynamic/sub-{wildcards.subid} --subid {wildcards.subid}"

rule aggregate_FCDs:
    input:
        expand(os.path.join(outdir, "results", "dynamic", "sub-{subid}", "sub-{subid}_FCD.csv"), subid=subids),
        expand(os.path.join(outdir, "results", "dynamic", "sub-{subid}", "sub-{subid}_FCD_hist.csv"), subid=subids),
        demo=os.path.join(outdir, "intermediaries", "demo_data.csv")
    params:
        workflowdir = workflowdir,
        outdir = outdir,
        subids=subids
    output:
        os.path.join(outdir, "results", "dynamic", "FCDs.pkl"),
        os.path.join(outdir, "results", "dynamic", "FCD_hists.pkl"),
        os.path.join(outdir, "results", "dynamic", "FCD_hists_regr.pkl")
    conda:
        os.path.join(environmentdir, "environment.yaml")
    shell:
        "python {params.workflowdir}/scripts/aggregate_FCDs.py --fcds_path {params.outdir}/results/dynamic/ --subids {params.subids} --demo_data_path {input.demo}"

rule plot_FCDs:
    input:
        os.path.join(outdir, "intermediaries", "demo_data.csv"),
        os.path.join(outdir, "results", "dynamic", "FCDs.pkl"),
        os.path.join(outdir, "results", "dynamic", "FCD_hists.pkl"),
        os.path.join(outdir, "results", "dynamic", "FCD_hists_regr.pkl")
    params:
        workflowdir = workflowdir,
        outdir = outdir,
        subids=subids
    output:
        os.path.join(outdir, "results", "dynamic", "images", "avg_FCD_comparison.png"),
        os.path.join(outdir, "results", "dynamic", "images", "avg_FCD_hist_comparison.png"),
        os.path.join(outdir, "results", "dynamic", "images", "avg_FCD_hist_comparison_regr.png")
    conda:
        os.path.join(environmentdir, "environment.yaml")
    shell:
        "mkdir -p {params.outdir}/results/dynamic/images && "
        "python {params.workflowdir}/scripts/plot_FCDs.py --fcds_path {params.outdir}/results/dynamic/ --subids {params.subids} --demo_data_path {input[0]}"

