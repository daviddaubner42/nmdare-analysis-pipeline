rule aggregate_global_metrics:
    input:
        expand(os.path.join(outdir, "results", "graph_theory", "global", "sub-{subid}", "sub-{subid}_avg_clustering.pkl"), subid=subids),
        expand(os.path.join(outdir, "results", "graph_theory", "global", "sub-{subid}", "sub-{subid}_global_efficiency.pkl"), subid=subids),
        expand(os.path.join(outdir, "results", "graph_theory", "global", "sub-{subid}", "sub-{subid}_assortativity.pkl"), subid=subids),
        expand(os.path.join(outdir, "results", "graph_theory", "global", "sub-{subid}", "sub-{subid}_robustness_random.pkl"), subid=subids),
        expand(os.path.join(outdir, "results", "graph_theory", "global", "sub-{subid}", "sub-{subid}_robustness_targeted.pkl"), subid=subids),
        expand(os.path.join(outdir, "results", "graph_theory", "global", "sub-{subid}", "sub-{subid}_modularity.pkl"), subid=subids),
        expand(os.path.join(outdir, "results", "graph_theory", "global", "sub-{subid}", "sub-{subid}_abs_mean_connectivity.pkl"), subid=subids),
        demo=os.path.join(outdir, "intermediaries", "demo_data.csv")
    params:
        workflowdir = workflowdir,
        outdir = outdir,
        subids=subids
    output:
        os.path.join(outdir, "results", "graph_theory", "global", "global_metrics.csv")
    conda:
        os.path.join(environmentdir, "environment.yaml")
    shell:
        "python {params.workflowdir}/scripts/aggregate_global_metrics.py --global_metrics_dir {params.outdir}/results/graph_theory/global/ --demo_data_path {input.demo} --out_path {output} --subids {params.subids}"

