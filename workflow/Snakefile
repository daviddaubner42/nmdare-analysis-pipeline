rule create_windowed_fcs:
    input:
        exc=os.path.join(outdir, "intermediaries", "networks", "to_delete_network.pkl"),
        ts=os.path.join(rawdir, "xcp_d", "sub-{subid}", "func", "sub-{subid}_task-rest_space-fsLR_seg-DesikanKilliany_den-91k_stat-mean_timeseries.ptseries.nii")
    params:
        workflowdir = workflowdir,
        outdir = outdir
    output:
        os.path.join(outdir, "results", "dynamic", "sub-{subid}", "sub-{subid}_windowed_FCs.pkl")
    conda:
        os.path.join(environmentdir, "environment.yaml")
    shell:
        "mkdir -p {params.outdir}/results/dynamic/sub-{wildcards.subid} && "
        "python {params.workflowdir}/scripts/create_windowed_fcs.py --ts_path {input.ts} --excluded_rois_path {input.exc} --out_path {output} --window_size 30 --step_size 1"

