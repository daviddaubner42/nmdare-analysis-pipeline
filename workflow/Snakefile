rule aggregate_local_metrics:
    input:
        expand(os.path.join(outdir, "results", "graph_theory", "local", "sub-{subid}", "sub-{subid}_betweenness_centrality.pkl"), subid=subids),
        expand(os.path.join(outdir, "results", "graph_theory", "local", "sub-{subid}", "sub-{subid}_degree_centrality.pkl"), subid=subids),
        expand(os.path.join(outdir, "results", "graph_theory", "local", "sub-{subid}", "sub-{subid}_clustering_coefficient.pkl"), subid=subids),
        expand(os.path.join(outdir, "results", "graph_theory", "local", "sub-{subid}", "sub-{subid}_avg_shortest_path_length.pkl"), subid=subids)
    params:
        workflowdir = workflowdir,
        outdir = outdir,
        subids = subids
    output:
        os.path.join(outdir, "results", "graph_theory", "local", "betweenness_centrality_aggregated.csv"),
        os.path.join(outdir, "results", "graph_theory", "local", "degree_centrality_aggregated.csv"),
        os.path.join(outdir, "results", "graph_theory", "local", "clustering_coefficient_aggregated.csv"),
        os.path.join(outdir, "results", "graph_theory", "local", "avg_shortest_path_length_aggregated.csv")
    conda:
        os.path.join(environmentdir, "environment.yaml")
    shell:
        "python {params.workflowdir}/scripts/aggregate_local_metrics.py --results_dir {params.outdir}/results/graph_theory/local/ --subids {params.subids}"

rule local_metric_comparison:
    input:
        os.path.join(outdir, "results", "graph_theory", "local", "{metric}_aggregated.csv"),
        demo=os.path.join(outdir, "intermediaries", "demo_data.csv")
    params:
        workflowdir = workflowdir,
        outdir = outdir
    output:
        os.path.join(outdir, "results", "graph_theory", "local", "{metric}_ps_stats.csv")
    conda:
        os.path.join(environmentdir, "environment.yaml")
    shell:
        "python {params.workflowdir}/scripts/local_metric_comparison.py --res_dir {params.outdir}/results/graph_theory/local --metric {wildcards.metric} --demo_data_path {input[1]}"

