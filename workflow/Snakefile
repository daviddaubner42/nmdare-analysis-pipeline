    shell:
        "mkdir -p {params.outdir}/results/graph_theory/images && "
        "python {params.workflowdir}/scripts/plot_global_metrics.py --global_metrics_dir {outdir}/results/graph_theory/global/"

""" Local metrics """

rule calculate_betweenness_centrality:
    input:
        os.path.join(outdir, "results", "static", "sub-{subid}", "sub-{subid}_FC_raw.csv"),
        os.path.join(outdir, "intermediaries", "networks", "network_labels.pkl")
    params:
        workflowdir = workflowdir,
        outdir = outdir,
        min_density = config["min_density"],
        max_density = config["max_density"],
        density_step = config["density_step"]
    output:
        os.path.join(outdir, "results", "graph_theory", "local", "sub-{subid}", "sub-{subid}_betweenness_centrality.pkl")
    conda:
        os.path.join(environmentdir, "environment.yaml")
    shell:
        "mkdir -p {params.outdir}/results/graph_theory/local/sub-{wildcards.subid} && "
        "python {params.workflowdir}/scripts/calculate_betweenness_centrality.py --fc_path {input[0]} --out_path {output} --min_density {params.min_density} --max_density {params.max_density} --density_step {params.density_step} --labels_path {input[1]}"

